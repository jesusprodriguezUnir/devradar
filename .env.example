# Token de GitHub para subir el rate limit de la Search API (opcional pero recomendado).
# Sin token funciona, pero con limites mas bajos (~10 req/min en search).
# Scope necesario: ninguno especial para repos publicos (public_repo basta de sobra).
GITHUB_TOKEN=

# API key de Anthropic para la categorizacion semantica (opcional).
# Si esta vacia, el pipeline usa solo categorizacion por reglas y omite Claude.
ANTHROPIC_API_KEY=

# Modelo de Claude a usar para clasificar/resumir (Haiku = barato y rapido).
CLAUDE_MODEL=claude-haiku-4-5-20251001

# URL y base para Astro (deben coincidir con tu despliegue en GitHub Pages).
SITE_URL=https://jesusprodriguez.github.io
BASE_PATH=/devradar
