---
import { CATEGORIES } from "../lib/categories.ts";
import { languages } from "../lib/resources.ts";
const langs = languages();
---
<div class="filterbar" id="filterbar">
  <input type="search" id="f-search" placeholder="Buscar por nombre, tag, descripción…" autocomplete="off" />

  <div class="chip-group" role="group" aria-label="Tipo">
    <button class="chip" data-type-filter="all" aria-pressed="true">Todos</button>
    <button class="chip" data-type-filter="repo" aria-pressed="false">Repos</button>
    <button class="chip" data-type-filter="skill" aria-pressed="false">Skills</button>
    <button class="chip" data-type-filter="website" aria-pressed="false">Webs</button>
  </div>

  <select id="f-category" aria-label="Categoría">
    <option value="all">Todas las categorías</option>
    {CATEGORIES.map((c) => <option value={c.slug}>{c.label}</option>)}
  </select>

  <select id="f-language" aria-label="Lenguaje">
    <option value="all">Cualquier lenguaje</option>
    {langs.map((l) => <option value={l}>{l}</option>)}
  </select>
</div>

<p class="empty" id="no-results" hidden>Sin resultados con esos filtros.</p>

<script is:inline>
  (() => {
    const $ = (s) => document.querySelector(s);
    const cards = Array.from(document.querySelectorAll(".js-card"));
    const sections = Array.from(document.querySelectorAll("[data-section]"));
    const search = $("#f-search");
    const catSel = $("#f-category");
    const langSel = $("#f-language");
    const noResults = $("#no-results");
    const typeChips = Array.from(document.querySelectorAll("[data-type-filter]"));
    let typeFilter = "all";

    function apply() {
      const q = (search.value || "").trim().toLowerCase();
      const cat = catSel.value;
      const lang = langSel.value;
      let visible = 0;

      for (const card of cards) {
        const okType = typeFilter === "all" || card.dataset.type === typeFilter;
        const okCat = cat === "all" || card.dataset.category === cat;
        const okLang = lang === "all" || card.dataset.language === lang;
        const okText = !q || (card.dataset.search || "").includes(q);
        const show = okType && okCat && okLang && okText;
        card.classList.toggle("is-hidden", !show);
        if (show) visible++;
      }

      // Oculta secciones que se quedan vacías tras filtrar.
      for (const section of sections) {
        const anyVisible = section.querySelector(".js-card:not(.is-hidden)");
        section.style.display = anyVisible ? "" : "none";
      }
      noResults.hidden = visible !== 0;
    }

    typeChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        typeFilter = chip.dataset.typeFilter;
        typeChips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
        apply();
      });
    });
    search.addEventListener("input", apply);
    catSel.addEventListener("change", apply);
    langSel.addEventListener("change", apply);
  })();
</script>
