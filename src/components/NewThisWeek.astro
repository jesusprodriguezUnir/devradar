---
import ResourceCard from "./ResourceCard.astro";
import { newThisWeek } from "../lib/resources.ts";
const items = newThisWeek.slice(0, 8);
---
{items.length > 0 && (
  <section class="section">
    <div class="section-head">
      <h2>✨ Nuevo esta semana</h2>
      <span class="count">{items.length}</span>
    </div>
    <div class="grid">
      {items.map((r) => <ResourceCard resource={r} />)}
    </div>
  </section>
)}
