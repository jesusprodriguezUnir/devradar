---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import { byType } from "../../lib/resources.ts";
import { TYPE_LABELS } from "../../lib/categories.ts";

export function getStaticPaths() {
  return (["repo", "skill", "website"] as const).map((type) => ({ params: { type } }));
}

const { type } = Astro.params as { type: "repo" | "skill" | "website" };
const items = byType(type).sort((a, b) => b.relevanceScore - a.relevanceScore);
const labels: Record<string, string> = { repo: "Repositorios", skill: "Skills", website: "Webs de referencia" };
---
<BaseLayout title={`${labels[type]} — DevRadar`}>
  <section class="hero" data-page-type={type}>
    <h1>{labels[type]}</h1>
    <p class="meta"><span data-count>{items.length}</span> recursos de tipo «{TYPE_LABELS[type]}»</p>
  </section>
  <div class="grid" data-grid hidden={items.length === 0}>
    {items.map((r) => <ResourceCard resource={r} />)}
  </div>
  <p class="empty" data-empty hidden={items.length !== 0}>Aún no hay recursos de este tipo.</p>

  <script>
    import { applyDynamicLayer } from "../../lib/dynamicCard.ts";
    const root = document.querySelector<HTMLElement>("[data-page-type]");
    const grid = document.querySelector<HTMLElement>("[data-grid]");
    const type = root?.dataset.pageType ?? "";
    if (grid) {
      applyDynamicLayer({
        filter: (r) => (r.type || "repo") === type,
        grid,
        empty: document.querySelector<HTMLElement>("[data-empty]"),
        count: document.querySelector<HTMLElement>("[data-count]"),
      });
    }
  </script>
</BaseLayout>
