---
import "../styles/dashboard.css";
import {
  allResources,
  newThisWeek,
  categoriesWithCounts,
  formatStars,
  generatedAt,
} from "../lib/resources.ts";

const base = import.meta.env.BASE_URL;

// Etiquetas cortas para chips y badges (la taxonomía completa vive en categories.ts).
const SHORT_LABEL: Record<string, string> = {
  "dotnet-backend": ".NET",
  "angular-frontend": "Angular",
  "architecture-patterns": "Arquitectura",
  "claude-ai": "Claude",
  "devops-tooling": "DevOps",
  "learning-reference": "Aprendizaje",
};
const shortLabel = (slug: string) => SHORT_LABEL[slug] ?? slug;

// Filas: todos los recursos ordenados por relevancia.
const rows = [...allResources].sort(
  (a, b) => b.relevanceScore - a.relevanceScore || a.name.localeCompare(b.name)
);

// Posiciones deterministas de los blips dentro del círculo del radar (en %).
function blip(id: string) {
  let h = 2166136261;
  for (let i = 0; i < id.length; i++) {
    h ^= id.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  h >>>= 0;
  const angle = (h % 360) * (Math.PI / 180);
  const radius = 11 + ((h >>> 9) % 1000) / 1000 * 34; // 11%..45%
  return {
    x: +(50 + radius * Math.cos(angle)).toFixed(2),
    y: +(50 + radius * Math.sin(angle)).toFixed(2),
  };
}

// Desglose por categoría (solo no vacías) para las barras de la derecha.
const cats = categoriesWithCounts();
const maxCount = Math.max(1, ...cats.map((c) => c.items.length));

// Chips de filtro: "Todas" + categorías con recursos.
const chips = [{ slug: "all", label: "Todas" }, ...cats.map((c) => ({ slug: c.slug, label: shortLabel(c.slug) }))];

const total = allResources.length;
const newCount = newThisWeek.length;
const updatedShort = new Date(generatedAt).toLocaleString("es-ES", { dateStyle: "medium", timeStyle: "short" });

const searchOf = (r: (typeof rows)[number]) =>
  [r.name, r.summary_es, r.tags.join(" "), r.language ?? "", shortLabel(r.category)]
    .join(" ")
    .toLowerCase();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DevRadar — tu radar de repos, webs y skills</title>
    <meta
      name="description"
      content="Dashboard que cura y categoriza repos, webs y skills relevantes para .NET, Angular, arquitectura y Claude."
    />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>📡</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Aplica el tema guardado antes de pintar para evitar parpadeo. -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("devradar:theme");
          document.documentElement.dataset.theme = t === "dark" ? "dark" : "light";
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body>
    <div class="dr-app">
      <!-- ===== SIDEBAR ===== -->
      <aside class="dr-side">
        <a class="dr-logo" href={base}>
          <span class="dr-logo-radar"><span class="dr-logo-sweep"></span></span>
          <span class="dr-logo-word">devradar</span>
        </a>

        <nav class="dr-nav">
          <button class="dr-navitem is-active" data-nav="all">
            <span>Mi radar</span>
          </button>
          <button class="dr-navitem" data-nav="new">
            <span>Novedades</span>
            {newCount > 0 && <span class="dr-badge dr-badge-accent">{newCount}</span>}
          </button>
          <button class="dr-navitem" data-nav="saved">
            <span>Guardados</span>
            <span class="dr-badge" data-saved-count>0</span>
          </button>
          <a class="dr-navitem" href={`${base}acerca`}>
            <span>Acerca</span>
          </a>
        </nav>

        <div class="dr-spacer"></div>

        <div class="dr-scan">
          <div class="dr-scan-top"><span class="dr-dot"></span> Escaneo activo</div>
          <div class="dr-scan-sub">Último barrido: {updatedShort} · {total} recursos</div>
        </div>

        <div class="dr-user">
          <div class="dr-avatar">J</div>
          <div>
            <div class="dr-user-name">Jesús P.</div>
            <div class="dr-user-plan">plan dev</div>
          </div>
        </div>
      </aside>

      <!-- ===== MAIN ===== -->
      <div class="dr-main">
        <!-- topbar -->
        <header class="dr-top">
          <div>
            <h1 class="dr-title">Mi radar</h1>
            <div class="dr-subtitle">Repos, webs y skills relevantes para .NET, Angular, arquitectura y Claude</div>
          </div>
          <div class="dr-tools">
            <div class="dr-search">
              <span class="dr-search-ico">⌕</span>
              <input id="dr-q" type="search" placeholder="Buscar repos, herramientas…" autocomplete="off" />
            </div>
            <button id="dr-theme" class="dr-btn-ghost" type="button" aria-label="Cambiar tema">
              <span data-theme-label>☾ Oscuro</span>
            </button>
            <button id="dr-token" class="dr-btn-ghost" type="button" aria-label="Configurar token de escritura">
              <span data-token-label>🔑 Token</span>
            </button>
            <button id="dr-add" class="dr-btn-solid" type="button">
              + Añadir fuente
            </button>
          </div>
        </header>

        <!-- content -->
        <div class="dr-content">
          <!-- LEFT: list -->
          <section class="dr-list-pane">
            <div class="dr-list-head">
              <div class="dr-chips" role="group" aria-label="Filtrar por categoría">
                {chips.map((c, i) => (
                  <button
                    class={`dr-chip ${i === 0 ? "is-active" : ""}`}
                    data-chip={c.slug}
                    aria-pressed={i === 0 ? "true" : "false"}
                  >{c.label}</button>
                ))}
              </div>
              <div class="dr-list-head-right">
                <label class="dr-sort">
                  <span class="dr-sort-label">Ordenar por</span>
                  <select id="dr-sort" aria-label="Ordenar por">
                    <option value="relevance">Relevancia</option>
                    <option value="stars">Estrellas</option>
                    <option value="recent">Recientes</option>
                    <option value="name">Nombre</option>
                  </select>
                </label>
                <span class="dr-count"><span data-count>{rows.length}</span> resultados</span>
              </div>
            </div>

            <div class="dr-scroll dr-list">
              {rows.map((r) => (
                <a
                  class="dr-row js-row"
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-category={r.category}
                  data-id={r.id}
                  data-new={newThisWeek.some((n) => n.id === r.id) ? "1" : "0"}
                  data-stars={r.stars ?? -1}
                  data-relevance={r.relevanceScore}
                  data-added={r.addedAt}
                  data-name={r.name.toLowerCase()}
                  data-search={searchOf(r)}
                >
                  <span class="dr-row-num"></span>
                  <span class="dr-row-body">
                    <span class="dr-row-line">
                      <span class="dr-row-name">{r.name}</span>
                      <span class="dr-row-cat">{shortLabel(r.category)}</span>
                    </span>
                    <span class="dr-row-desc">{r.summary_es}</span>
                  </span>
                  <span class="dr-row-meta">
                    {r.stars !== null ? (
                      <span class="dr-row-stars">★ {formatStars(r.stars)}</span>
                    ) : (
                      <span class="dr-row-stars dr-muted">{r.language ?? "—"}</span>
                    )}
                    {r.starsDelta > 0 && <span class="dr-row-delta">+{r.starsDelta}</span>}
                  </span>
                  <button
                    class="dr-save"
                    type="button"
                    data-save={r.id}
                    aria-pressed="false"
                    onclick="event.preventDefault(); event.stopPropagation();"
                  >+ GUARDAR</button>
                  <button
                    class="dr-del"
                    type="button"
                    data-del={r.id}
                    aria-label="Eliminar del radar"
                    title="Eliminar del radar"
                    onclick="event.preventDefault(); event.stopPropagation();"
                  >✕</button>
                </a>
              ))}
              <p class="dr-empty" data-empty hidden>Sin resultados con esos filtros.</p>
            </div>
          </section>

          <!-- RIGHT: radar + stats + categorías -->
          <aside class="dr-scroll dr-aside">
            <div class="dr-radar-card">
              <div class="dr-card-head">
                <span class="dr-card-title">RADAR</span>
                <span class="dr-card-sub" data-filter-label>todas las categorías</span>
              </div>
              <div class="dr-radar-wrap">
                <div class="dr-radar">
                  <div class="dr-radar-sweep"></div>
                  <div class="dr-radar-vline"></div>
                  <div class="dr-radar-hline"></div>
                  <div class="dr-radar-core"></div>
                  {rows.map((r) => {
                    const p = blip(r.id);
                    return (
                      <span
                        class="dr-blip"
                        data-blip={r.id}
                        data-category={r.category}
                        style={`left:${p.x}%; top:${p.y}%;`}
                      ></span>
                    );
                  })}
                </div>
              </div>
            </div>

            <div class="dr-stats">
              <div class="dr-stat">
                <div class="dr-stat-num">{total}</div>
                <div class="dr-stat-label">en radar</div>
              </div>
              <div class="dr-stat">
                <div class="dr-stat-num dr-accent">+{newCount}</div>
                <div class="dr-stat-label">esta semana</div>
              </div>
              <div class="dr-stat">
                <div class="dr-stat-num" data-saved-count>0</div>
                <div class="dr-stat-label">guardados</div>
              </div>
            </div>

            <div class="dr-catbreak">
              <span class="dr-card-title">POR CATEGORÍA</span>
              {cats.map((c) => (
                <div class="dr-catrow">
                  <span class="dr-cat-label">{shortLabel(c.slug)}</span>
                  <span class="dr-cat-track">
                    <span class="dr-cat-bar" style={`width:${(c.items.length / maxCount) * 100}%`}></span>
                  </span>
                  <span class="dr-cat-count">{c.items.length}</span>
                </div>
              ))}
            </div>
          </aside>
        </div>
      </div>
    </div>

    <!-- ===== MODAL: añadir fuente ===== -->
    <div class="dr-modal" id="dr-add-modal" hidden>
      <div class="dr-modal-backdrop" data-close></div>
      <form class="dr-modal-box" id="dr-add-form">
        <h2 class="dr-modal-title">Añadir fuente</h2>
        <p class="dr-modal-hint">Pega la URL de un repo de GitHub (o <code>owner/name</code>).</p>
        <label class="dr-field">
          <span>Repositorio</span>
          <input id="dr-add-url" type="text" placeholder="https://github.com/owner/name" autocomplete="off" required />
        </label>
        <label class="dr-field">
          <span>Categoría (opcional)</span>
          <select id="dr-add-cat">
            <option value="">— Sin categoría —</option>
            {cats.map((c) => (
              <option value={c.slug}>{shortLabel(c.slug)}</option>
            ))}
          </select>
        </label>
        <p class="dr-modal-err" data-add-err hidden></p>
        <div class="dr-modal-actions">
          <button type="button" class="dr-btn-ghost" data-close>Cancelar</button>
          <button type="submit" class="dr-btn-solid" id="dr-add-submit">Añadir</button>
        </div>
      </form>
    </div>

    <script is:inline>
      (() => {
        const $ = (s, r = document) => r.querySelector(s);
        const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
        const SAVED_KEY = "devradar:saved";
        const THEME_KEY = "devradar:theme";
        const SORT_KEY = "devradar:sort";
        const TOKEN_KEY = "devradar:token";
        const API = "/api";

        // ----- etiquetas y formato (espejo de index.astro) -----
        const SHORT_LABEL = {
          "dotnet-backend": ".NET",
          "angular-frontend": "Angular",
          "architecture-patterns": "Arquitectura",
          "claude-ai": "Claude",
          "devops-tooling": "DevOps",
          "learning-reference": "Aprendizaje",
        };
        const shortLabel = (slug) => SHORT_LABEL[slug] || slug || "";
        const formatStars = (n) => {
          if (n === null || n === undefined) return "";
          if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "k";
          return String(n);
        };
        // Posición determinista del blip (espejo de blip() en el frontmatter).
        const blip = (id) => {
          let h = 2166136261;
          for (let i = 0; i < id.length; i++) {
            h ^= id.charCodeAt(i);
            h = Math.imul(h, 16777619);
          }
          h >>>= 0;
          const angle = (h % 360) * (Math.PI / 180);
          const radius = 11 + (((h >>> 9) % 1000) / 1000) * 34;
          return {
            x: +(50 + radius * Math.cos(angle)).toFixed(2),
            y: +(50 + radius * Math.sin(angle)).toFixed(2),
          };
        };
        const searchOf = (r) =>
          [r.name, r.summary_es, (r.tags || []).join(" "), r.language || "", shortLabel(r.category)]
            .join(" ")
            .toLowerCase();

        // ----- token de escritura (localStorage) -----
        const getToken = () => {
          try { return localStorage.getItem(TOKEN_KEY) || ""; } catch (e) { return ""; }
        };
        const setToken = (t) => {
          try { t ? localStorage.setItem(TOKEN_KEY, t) : localStorage.removeItem(TOKEN_KEY); } catch (e) {}
          syncTokenUI();
        };
        const syncTokenUI = () => {
          const has = !!getToken();
          document.body.classList.toggle("has-token", has);
          const label = $("[data-token-label]");
          if (label) label.textContent = has ? "🔑 Token ✓" : "🔑 Token";
        };

        // ----- construye una fila .dr-row (para repos manuales) -----
        const renderRow = (r) => {
          const a = document.createElement("a");
          a.className = "dr-row js-row";
          a.href = r.url;
          a.target = "_blank";
          a.rel = "noopener noreferrer";
          a.dataset.category = r.category || "";
          a.dataset.id = r.id;
          a.dataset.new = "0";
          a.dataset.stars = r.stars === null || r.stars === undefined ? -1 : r.stars;
          a.dataset.relevance = 100000; // los añadidos a mano, arriba del todo en "relevancia"
          a.dataset.added = r.addedAt || "";
          a.dataset.name = (r.name || "").toLowerCase();
          a.dataset.search = searchOf(r);
          a.dataset.manual = "1";

          const num = document.createElement("span");
          num.className = "dr-row-num";

          const body = document.createElement("span");
          body.className = "dr-row-body";
          const line = document.createElement("span");
          line.className = "dr-row-line";
          const name = document.createElement("span");
          name.className = "dr-row-name";
          name.textContent = r.name || r.id;
          const cat = document.createElement("span");
          cat.className = "dr-row-cat";
          cat.textContent = shortLabel(r.category);
          line.append(name, cat);
          const desc = document.createElement("span");
          desc.className = "dr-row-desc";
          desc.textContent = r.summary_es || r.description || "";
          body.append(line, desc);

          const meta = document.createElement("span");
          meta.className = "dr-row-meta";
          const stars = document.createElement("span");
          if (r.stars !== null && r.stars !== undefined) {
            stars.className = "dr-row-stars";
            stars.textContent = "★ " + formatStars(r.stars);
          } else {
            stars.className = "dr-row-stars dr-muted";
            stars.textContent = r.language || "—";
          }
          meta.append(stars);

          const save = document.createElement("button");
          save.className = "dr-save";
          save.type = "button";
          save.dataset.save = r.id;
          save.setAttribute("aria-pressed", "false");
          save.textContent = "+ GUARDAR";
          save.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); });

          const del = document.createElement("button");
          del.className = "dr-del";
          del.type = "button";
          del.dataset.del = r.id;
          del.setAttribute("aria-label", "Eliminar del radar");
          del.title = "Eliminar del radar";
          del.textContent = "✕";
          del.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); });

          a.append(num, body, meta, save, del);
          return a;
        };

        // Añade un blip al radar para un recurso inyectado.
        const addBlip = (r) => {
          const radar = $(".dr-radar");
          if (!radar) return;
          const p = blip(r.id);
          const b = document.createElement("span");
          b.className = "dr-blip";
          b.dataset.blip = r.id;
          b.dataset.category = r.category || "";
          b.style.left = p.x + "%";
          b.style.top = p.y + "%";
          radar.appendChild(b);
        };

        // ----- estado guardado (localStorage) -----
        const loadSaved = () => {
          try { return new Set(JSON.parse(localStorage.getItem(SAVED_KEY) || "[]")); }
          catch (e) { return new Set(); }
        };
        let saved = loadSaved();
        const persist = () => {
          try { localStorage.setItem(SAVED_KEY, JSON.stringify([...saved])); } catch (e) {}
        };

        let rows = $$(".js-row");
        const listEl = $(".dr-list");
        const chips = $$("[data-chip]");
        const navItems = $$("[data-nav]");
        const q = $("#dr-q");
        const emptyEl = $("[data-empty]");
        const countEl = $("[data-count]");
        const filterLabelEl = $("[data-filter-label]");
        const sortSelect = $("#dr-sort");

        let category = "all";   // chip activo
        let scope = "all";      // nav: all | new | saved

        // ----- orden (localStorage) -----
        const loadSort = () => {
          try { return localStorage.getItem(SORT_KEY) || "relevance"; }
          catch (e) { return "relevance"; }
        };
        let sortMode = loadSort();
        const num = (v) => Number(v);
        const comparators = {
          // Relevancia: orden de build (desc), desempate por nombre.
          relevance: (a, b) =>
            num(b.dataset.relevance) - num(a.dataset.relevance) ||
            a.dataset.name.localeCompare(b.dataset.name),
          // Estrellas desc; los sin estrellas (-1) quedan al final.
          stars: (a, b) =>
            num(b.dataset.stars) - num(a.dataset.stars) ||
            num(b.dataset.relevance) - num(a.dataset.relevance),
          // Recientes: addedAt (ISO) desc.
          recent: (a, b) => (b.dataset.added || "").localeCompare(a.dataset.added || ""),
          // Nombre asc.
          name: (a, b) => a.dataset.name.localeCompare(b.dataset.name),
        };
        // Filas en el orden visual actual (las usa apply() para numerar).
        let orderedRows = rows.slice();
        const sortRows = () => {
          const cmp = comparators[sortMode] || comparators.relevance;
          orderedRows = rows.slice().sort(cmp);
          orderedRows.forEach((row) => listEl.appendChild(row));
        };

        const labelFor = (slug) => {
          const chip = chips.find((c) => c.dataset.chip === slug);
          return slug === "all" ? "todas las categorías" : (chip ? chip.textContent.trim() : slug);
        };

        // ----- guardado por fila -----
        const refreshSavedUI = () => {
          rows.forEach((row) => {
            const btn = $(".dr-save", row);
            const isSaved = saved.has(row.dataset.id);
            btn.classList.toggle("is-saved", isSaved);
            btn.setAttribute("aria-pressed", String(isSaved));
            btn.textContent = isSaved ? "✓ GUARDADO" : "+ GUARDAR";
          });
          $$("[data-blip]").forEach((b) => b.classList.toggle("is-saved", saved.has(b.dataset.blip)));
          const n = String(saved.size);
          $$("[data-saved-count]").forEach((el) => (el.textContent = n));
        };

        // POST/DELETE contra la API (best-effort; localStorage es la fuente optimista).
        const syncSaved = (id, on) => {
          const opts = { method: on ? "POST" : "DELETE", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id }) };
          fetch(`${API}/saved`, opts).catch(() => {});
        };
        const deleteResource = (row) => {
          const id = row.dataset.id;
          const token = getToken();
          if (!token) { alert("Configura un token de escritura para eliminar."); return; }
          if (!confirm("¿Eliminar este recurso del radar?")) return;
          fetch(`${API}/repos`, {
            method: "DELETE",
            headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
            body: JSON.stringify({ id }),
          })
            .then((res) => {
              if (!res.ok) throw new Error(String(res.status));
              // Quita la fila y su blip; refresca listas y vista.
              const b = $(`[data-blip="${CSS.escape(id)}"]`);
              if (b) b.remove();
              row.remove();
              if (saved.has(id)) { saved.delete(id); persist(); syncSaved(id, false); }
              rows = $$(".js-row");
              refreshSavedUI();
              sortRows();
              apply();
            })
            .catch((err) => alert("No se pudo eliminar: " + err.message));
        };

        // Engancha los botones de una fila (idempotente).
        const bindRow = (row) => {
          if (row.dataset.bound === "1") return;
          row.dataset.bound = "1";
          const save = $(".dr-save", row);
          if (save) {
            save.addEventListener("click", (e) => {
              e.preventDefault();
              e.stopPropagation();
              const id = save.dataset.save;
              const on = !saved.has(id);
              if (on) saved.add(id); else saved.delete(id);
              persist();
              syncSaved(id, on);
              refreshSavedUI();
              apply();
            });
          }
          const del = $(".dr-del", row);
          if (del) del.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); deleteResource(row); });
        };

        // ----- filtrado -----
        const apply = () => {
          const text = (q.value || "").trim().toLowerCase();
          let visible = 0;
          orderedRows.forEach((row) => {
            const okCat = category === "all" || row.dataset.category === category;
            const okScope =
              scope === "all" ||
              (scope === "new" && row.dataset.new === "1") ||
              (scope === "saved" && saved.has(row.dataset.id));
            const okText = !text || (row.dataset.search || "").includes(text);
            const show = okCat && okScope && okText;
            row.classList.toggle("is-hidden", !show);
            if (show) {
              visible++;
              $(".dr-row-num", row).textContent = String(visible).padStart(2, "0");
            }
          });
          countEl.textContent = String(visible);
          emptyEl.hidden = visible !== 0;

          // radar: enciende los blips de la categoría activa
          $$("[data-blip]").forEach((b) => {
            b.classList.toggle("is-off", !(category === "all" || b.dataset.category === category));
          });
          filterLabelEl.textContent = labelFor(category);
        };

        chips.forEach((chip) => {
          chip.addEventListener("click", () => {
            category = chip.dataset.chip;
            chips.forEach((c) => {
              const on = c === chip;
              c.classList.toggle("is-active", on);
              c.setAttribute("aria-pressed", String(on));
            });
            apply();
          });
        });

        navItems.forEach((item) => {
          item.addEventListener("click", () => {
            scope = item.dataset.nav;
            navItems.forEach((n) => n.classList.toggle("is-active", n === item));
            apply();
          });
        });

        q.addEventListener("input", apply);

        sortSelect.value = sortMode;
        sortSelect.addEventListener("change", () => {
          sortMode = sortSelect.value;
          try { localStorage.setItem(SORT_KEY, sortMode); } catch (e) {}
          sortRows();
          apply();
        });

        // ----- tema -----
        const themeBtn = $("#dr-theme");
        const themeLabel = $("[data-theme-label]");
        const syncThemeLabel = () => {
          const dark = document.documentElement.dataset.theme === "dark";
          themeLabel.textContent = dark ? "☀ Claro" : "☾ Oscuro";
        };
        themeBtn.addEventListener("click", () => {
          const dark = document.documentElement.dataset.theme === "dark";
          const next = dark ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem(THEME_KEY, next); } catch (e) {}
          syncThemeLabel();
        });

        // ----- token + modal de añadir fuente -----
        const tokenBtn = $("#dr-token");
        if (tokenBtn) tokenBtn.addEventListener("click", () => {
          const next = prompt("Token de escritura (Bearer). Déjalo vacío para borrarlo:", getToken());
          if (next !== null) setToken(next.trim());
        });

        const modal = $("#dr-add-modal");
        const addForm = $("#dr-add-form");
        const addUrl = $("#dr-add-url");
        const addCat = $("#dr-add-cat");
        const addErr = $("[data-add-err]");
        const addSubmit = $("#dr-add-submit");
        const openModal = () => { if (!modal) return; addErr.hidden = true; modal.hidden = false; addUrl.focus(); };
        const closeModal = () => { if (modal) modal.hidden = true; };
        const addBtn = $("#dr-add");
        if (addBtn) addBtn.addEventListener("click", openModal);
        $$("[data-close]").forEach((el) => el.addEventListener("click", closeModal));
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });

        // Inyecta un repo en la lista + radar y refresca todo.
        const injectRepo = (r) => {
          if (!r || rows.some((row) => row.dataset.id === r.id)) return;
          const el = renderRow(r);
          listEl.appendChild(el);
          bindRow(el);
          addBlip(r);
          rows = $$(".js-row");
          refreshSavedUI();
          sortRows();
          apply();
        };

        if (addForm) addForm.addEventListener("submit", (e) => {
          e.preventDefault();
          const token = getToken();
          if (!token) { addErr.textContent = "Configura primero un token de escritura (🔑)."; addErr.hidden = false; return; }
          const url = addUrl.value.trim();
          if (!url) return;
          addSubmit.disabled = true;
          addErr.hidden = true;
          fetch(`${API}/repos`, {
            method: "POST",
            headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
            body: JSON.stringify({ url, category: addCat.value || null }),
          })
            .then(async (res) => {
              const data = await res.json().catch(() => ({}));
              if (!res.ok) throw new Error(data.error || ("Error " + res.status));
              injectRepo(data.repo);
              addUrl.value = "";
              closeModal();
            })
            .catch((err) => { addErr.textContent = err.message; addErr.hidden = false; })
            .finally(() => { addSubmit.disabled = false; });
        });

        // ----- init -----
        syncThemeLabel();
        syncTokenUI();
        rows.forEach(bindRow);
        refreshSavedUI();
        sortRows();
        apply();

        // Capa dinámica: fusiona el estado del servidor (D1) sobre el catálogo estático.
        fetch(`${API}/state`)
          .then((res) => (res.ok ? res.json() : null))
          .then((state) => {
            if (!state) return;
            const removed = new Set(state.removedIds || []);
            rows.forEach((row) => {
              if (removed.has(row.dataset.id)) {
                row.remove();
                const b = $(`[data-blip="${CSS.escape(row.dataset.id)}"]`);
                if (b) b.remove();
              }
            });
            // IDs realmente presentes tras las eliminaciones: evita inyectar duplicados
            // de un repo manual que también existe (con el mismo id) en el catálogo estático.
            const present = new Set($$(".js-row").map((row) => row.dataset.id));
            (state.manualRepos || []).forEach((r) => {
              if (!removed.has(r.id) && !present.has(r.id)) {
                present.add(r.id);
                const el = renderRow(r);
                listEl.appendChild(el);
                bindRow(el);
                addBlip(r);
              }
            });
            (state.saved || []).forEach((id) => saved.add(id));
            persist();
            rows = $$(".js-row");
            refreshSavedUI();
            sortRows();
            apply();
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>
